"""OCaml toolchain registration for weidu-augmented.

The toolchain is selected when the exec and target platforms match the
Linux x86_64 constraints: builds run natively on the host.  Windows
target platforms are handled by the container cross-build
(//:weidu_win_docker, see bazel/win_docker.bzl) — no native Windows
toolchain exists, so native OCaml rules fail toolchain resolution on
Windows targets by design.
"""

load("//bazel/ocaml:toolchain.bzl", "ocaml_toolchain")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

ocaml_toolchain(
    name = "linux_toolchain_def",
    bash = "@ocaml_toolchain_linux//:bash",
    compiler = "@ocaml_toolchain_linux//:compiler",
    elkhound = "@elkhound//:elkhound",
    ocaml = "@ocaml_toolchain_linux//:ocaml",
    ocamllex = "@ocaml_toolchain_linux//:ocamllex",
    ocamlyacc = "@ocaml_toolchain_linux//:ocamlyacc",
    tool_files = "@ocaml_toolchain_linux//:tool_files",
    os = "linux",
)

toolchain(
    name = "ocaml_linux",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":linux_toolchain_def",
    toolchain_type = ":toolchain_type",
)
