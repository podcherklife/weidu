"""weidu-augmented: WeiDU fork with --trace/--dump-ast observability tooling.

Consumable as a Bazel module by upstream projects:

    bazel_dep(name = "weidu_augmented", version = "25201.0.0")
    # plus, until this is published to the BCR:
    git_override(
        module_name = "weidu_augmented",
        remote = "https://github.com/podcherklife/weidu.git",
        commit = "<commit>",
    )

then reference //:weidu, //:weinstall, //:tolower.  Unix targets build
the OCaml toolchain from upstream source on the host (gcc + make); the
windows_x86_64 target cross-compiles inside a pinned container image
(a docker/podman runtime on the exec host is required).  See
bazel/README.md.
"""

module(
    name = "weidu_augmented",
    version = "25201.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")

# Linux: build OCaml 4.08.1 from upstream source on the host (gcc + make).
ocaml_linux_toolchain_repo = use_repo_rule("//bazel/ocaml:repos.bzl", "ocaml_linux_toolchain_repo")
ocaml_linux_toolchain_repo(name = "ocaml_toolchain_linux")

# elkhound parser generator binaries (same release the Makefile/CI use).
elkhound_repo = use_repo_rule("//bazel/ocaml:repos.bzl", "elkhound_repo")
elkhound_repo(name = "elkhound")

# Windows target platforms are handled by the container cross-build
# (//:weidu_win_docker); no native Windows OCaml toolchain is registered.
register_toolchains("//bazel/ocaml:ocaml_linux")
