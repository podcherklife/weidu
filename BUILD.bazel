    name = "c_hdrs",
    srcs = [
        "zlib/crc32.h",
        "zlib/deflate.h",
        "zlib/inffast.h",
        "zlib/inffixed.h",
        "zlib/inflate.h",
        "zlib/inftrees.h",
        "zlib/trees.h",
        "zlib/zconf.h",
        "zlib/zlib.h",
        "zlib/zlibdefs.h",
        "zlib/zutil.h",
        "xdiff/xadler32.h",
        "xdiff/xbdiff.h",
        "xdiff/xdiff.h",
        "xdiff/xdiffi.h",
        "xdiff/xemit.h",
        "xdiff/xinclude.h",
        "xdiff/xmacros.h",
        "xdiff/xmissing.h",
        "xdiff/xprepare.h",
        "xdiff/xtypes.h",
        "xdiff/xutils.h",
    ],
)

