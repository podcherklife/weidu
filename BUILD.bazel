    ":c_deflate",
    ":c_trees",
]
_C_XDIFF_FAMILY = [
    ":c_xdiff",
    ":c_xemit",
    ":c_xpatchi",
    ":c_xutils",
    ":c_xdiffi",
    ":c_xprepare",
]
_C_MODULES_WEIDU = select({
    "//platforms:windows": [":c_reg", ":c_createprocess_win32", ":c_glob_win32"] +
                           _C_ZLIB_FAMILY + _C_XDIFF_FAMILY,
    "//conditions:default": [":c_nix", ":c_fcase", ":c_glob_unix"] +
                            _C_ZLIB_FAMILY + _C_XDIFF_FAMILY,
})
_C_MODULES_WEINSTALL = select({
    "//conditions:default": [":c_fcase"],
    "//platforms:windows": [],
    "//platforms:macos": [],
})

# ---------------------------------------------------------------------------
# Codegen chain (Depends:26-55).  All scripts run under the toolchain's OCaml
# interpreter with `str.cma unix.cma`, exactly as the make rules do.
# ---------------------------------------------------------------------------
ocaml_codegen(
    name = "tph_gen",
    script = "scripts/make_tph.ml",
    script_rel = "scripts/make_tph.ml",
    stage = {
        "src/tph/define/add_spell.tpa": "src/tph/define/add_spell.tpa",
        "src/tph/define/fl#add_journal_lua.tpa": "src/tph/define/fl#add_journal_lua.tpa",
        "src/tph/define/fl#create.tpa": "src/tph/define/fl#create.tpa",
        "src/tph/define/lc_fix_missile_ids.tpa": "src/tph/define/lc_fix_missile_ids.tpa",
        "src/tph/define/tb#pretty_print.tpp": "src/tph/define/tb#pretty_print.tpp",
        "src/tph/include/a7_pvrz.tpa": "src/tph/include/a7_pvrz.tpa",
        "src/tph/include/cd_functions.tpa": "src/tph/include/cd_functions.tpa",
        "src/tph/include/fj_are_struct.tpa": "src/tph/include/fj_are_struct.tpa",
        "src/tph/include/fj_cre_validity.tpa": "src/tph/include/fj_cre_validity.tpa",
        "src/tph/include/fl_functions.tpa": "src/tph/include/fl_functions.tpa",
        "src/tph/include/g_functions.tpa": "src/tph/include/g_functions.tpa",
        "src/tph/include/g_macros.tpa": "src/tph/include/g_macros.tpa",
        "src/tph/include/get_unique_file_name.tpa": "src/tph/include/get_unique_file_name.tpa",
        "src/tph/include/handle_audio.tpa": "src/tph/include/handle_audio.tpa",
        "src/tph/include/handle_charsets.tpa": "src/tph/include/handle_charsets.tpa",
        "src/tph/include/handle_tilesets.tpa": "src/tph/include/handle_tilesets.tpa",
        "src/tph/include/res_of_spell_ids.tpa": "src/tph/include/res_of_spell_ids.tpa",
        "src/tph/include/sc#addwmpare.tpa": "src/tph/include/sc#addwmpare.tpa",
        "src/tph/include/star_of_filespec.tpa": "src/tph/include/star_of_filespec.tpa",
        "src/tph/include/store_functions.tpa": "src/tph/include/store_functions.tpa",
        "src/tph/include/tb#macros.tpa": "src/tph/include/tb#macros.tpa",
        "src/tph/include/tb#tob_hacks.tpa": "src/tph/include/tb#tob_hacks.tpa",
        "src/tph/include/worldmap_links.tpa": "src/tph/include/worldmap_links.tpa",
    },
    outs = ["tph.ml"],
    staging_paths = ["src/tph.ml"],
    interpreter_opts = ["-w", "p", "-unsafe-string"],
)

ocaml_codegen(
    name = "trealparserin_gr_gen",
    script = "scripts/make_gr.ml",
    script_rel = "scripts/make_gr.ml",
    stage = {
        "src/aliases.in": "src/aliases.in",
        "src/trealparserin.in": "src/trealparserin.in",
    },
    outs = ["trealparserin.gr"],
    staging_paths = ["src/trealparserin.gr"],
)

ocaml_elkhound(
    name = "trealparserin_gen",
    gr = ":trealparserin.gr",
    outs = [
        "trealparserin.ml",
        "trealparserin.mli",
    ],
)

ocaml_codegen(
    name = "trealparser_gen",
    script = "scripts/make_compr_parser.ml",
    script_rel = "scripts/make_compr_parser.ml",
    stage = {
        ":trealparserin.ml": "trealparserin.ml",
    },
    args = [
        "trealparserin.ml",
        "trealparser.ml",
    ],
    copy = {
        ":trealparserin.mli": "trealparser.mli",
    },
    outs = [
        "trealparser.ml",
        "trealparser.mli",
    ],
    staging_paths = [
        "trealparser.ml",
        "trealparser.mli",
    ],
)

ocaml_codegen(
    name = "tlexer_mll_gen",
    script = "scripts/make_tll.ml",
    script_rel = "scripts/make_tll.ml",
    stage = {
        "src/tlexer.in": "src/tlexer.in",
        ":trealparserin.gr": "src/trealparserin.gr",
    },
    outs = ["tlexer.mll"],
    staging_paths = ["src/tlexer.mll"],
)

ocaml_codegen(
    name = "toldlexer_mll_gen",
    script = "scripts/make_old_mll.ml",
    script_rel = "scripts/make_old_mll.ml",
    stage = {
        "src/toldlexer.in": "src/toldlexer.in",
        ":trealparserin.gr": "src/trealparserin.gr",
    },
    outs = ["toldlexer.mll"],
    staging_paths = ["src/toldlexer.mll"],
)

# Platform selection for arch.ml/case_ins.ml/arch2.ml (Configuration lines
# 8-81 replaced by select()); arch2.ml bakes WEIDU_ARCH/WEIDU_OS strings.
ocaml_write(
    name = "arch2_gen",
    out = "arch2.ml",
    content = select({
        "//platforms:windows": _ARCH2_CONTENT_WIN,
        "//platforms:macos": _ARCH2_CONTENT_OSX,
        "//conditions:default": _ARCH2_CONTENT_UNIX,
    }),
)

ocaml_windres(
    name = "weidu_resources_o",
    out = "weidu_resources.o",
    rc = "windows_resources/weidu_resources.rc",
    target_compatible_with = ["@platforms//os:windows"],
    version = "src/version.ml",
)

