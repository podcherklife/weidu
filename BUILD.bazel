# Module targets shared by the secondary executables are declared exactly
# once (by the weidu chain) and reused by label.
ocaml_module_chain(_MODULES)
_ALL_LABELS = [":" + m["name"] for m in _MODULES]

ocaml_binary(
    name = "weidu_native",
    modules = _ALL_LABELS,
    c_modules = _C_MODULES_WEIDU,
    extra_linkopts = select({
        "//platforms:windows": ["-cclib", "-ladvapi32"],
        "//conditions:default": [],
    }),
    resources = select({
        "//platforms:windows": [":weidu_resources_o"],
        "//conditions:default": [],
    }),
)

ocaml_module(
    name = "weinstall_mod",
    src = "src/weinstall.ml",
    deps = _ALL_LABELS,
)
ocaml_binary(
    name = "weinstall_native",
    modules = [
        ":batList",
        ":batteriesInit",
        ":case_ins",
        ":weinstall_mod",
    ],
    c_modules = _C_MODULES_WEINSTALL,
)

ocaml_module(
    name = "tolower_mod",
    src = "src/tolower.ml",
    deps = _ALL_LABELS,
)
ocaml_binary(
    name = "tolower_native",
    modules = [
        ":batList",
        ":batteriesInit",
        ":tolower_mod",
    ],
)

# Full sanity check: version banner, D -> DLG compile, DLG -> D round trip
# and rejection of a known-bad file, all without an Infinity Engine game
# (uses the upstream test/no-game fixture; see defs.bzl docstring).
ocaml_sanity_check(
    name = "sanity",
    bad_file = "not-token.d",
    binary = ":weidu_native",
    good_file = "make-foozle.d",
    roundtrip_expect = "Abracadabra",
    stage = {
        "test/bad-syntax/not-token.d": "not-token.d",
        "test/no-game/make-foozle.d": "make-foozle.d",
    },
)

filegroup(
    name = "distribute_binaries",
    srcs = [
        ":weidu",
        ":weinstall",
        ":tolower",
    ],
)

# ---------------------------------------------------------------------------
# Windows cross-build via the container image in docker/win-cross.
#
# weidu_win_docker bundles the tracked sources below into src.tar and runs
# the project's own GNU make build inside the container (see
# bazel/win_docker.bzl).  Tagged manual so plain `bazel build //...` stays
# light; CI (and consumers) build it explicitly, or get it through the
# platform-dispatched aliases below.
#
# docker_srcs is an explicit list mirroring the tracked files of these
# directories (never a glob: stale gitignored generated files in src/ must
# not leak into the bundle).
# ---------------------------------------------------------------------------
filegroup(
    name = "docker_srcs",
    srcs = [
        # top-level make engine
        "Configuration",
        "Depends",
        "Makefile",
        "Makefile.ocaml",
        # batteries-lite
        "batteries-lite/batList.ml",
        "batteries-lite/batList.mli",
        "batteries-lite/batteriesInit.ml",
        # elkhound OCaml runtime (Depends' smutil/glr/lrparse/... modules)
        "elkhound/arraystack.ml",
        "elkhound/glr.ml",
        "elkhound/lexerint.ml",
        "elkhound/license.txt",
        "elkhound/lrparse.ml",
        "elkhound/objpool.ml",
        "elkhound/parsetables.ml",
        "elkhound/smutil.ml",
        "elkhound/useract.ml",
        # fcase / glob
        "fcase/fcase.c",
        "glob/glob_unix.c",
        "glob/glob_win32.c",
        # hashtbl-4.03.0
        "hashtbl-4.03.0/hashtblinit.ml",
        "hashtbl-4.03.0/myhashtbl.ml",
        "hashtbl-4.03.0/myhashtbl.mli",
        # codegen scripts
        "scripts/build-augmented.sh",
        "scripts/make_compr_parser.ml",
        "scripts/make_gr.ml",
        "scripts/make_old_mll.ml",
        "scripts/make_par.ml",
        "scripts/make_tll.ml",
        "scripts/make_tph.ml",
        # src
        "src/aliases.in",
        "src/arch_legacy_osx.ml",
        "src/arch_mingw.ml",
        "src/arch_osx.ml",
        "src/arch_unix.ml",
        "src/astdump.ml",
        "src/astdumpBcs.ml",
