"""Build definitions for weidu-augmented.

Mirrors the hand-rolled make build (Makefile + Depends + Configuration):

  * WEIDU_MODULES  -> ocaml_module_chain(_MODULES) + ocaml_binary with the
    exact link order from Depends (the chain gives each module the
    interfaces of all earlier modules, a conservative superset of
    ocamldep).
  * weinstall/tolower secondary executables (Makefile PROJECT3/PROJECT4).
  * Platform selection (Configuration): arch.ml/case_ins.ml/arch2.ml are
    chosen with select() on the target platform instead of file copies.
  * Codegen chain from Depends: make_tph/make_gr/make_tll/make_old_mll/
    make_compr_parser run under the toolchain's OCaml interpreter, parser
    tables come from elkhound, lexers/parsers from ocamllex/ocamlyacc.
  * Windows extra: reg.c/createprocess_win32.c/glob_win32.c, -ladvapi32 and
    the weidu_resources.rc version resource (windres).

All module source files live in the root package (no BUILD files exist in
src/, elkhound/, etc.), so labels are plain workspace-relative paths.
"""

load(
    "//bazel/ocaml:defs.bzl",
    "ocaml_binary",
    "ocaml_c_module",
    "ocaml_codegen",
    "ocaml_elkhound",
    "ocaml_module",
    "ocaml_module_chain",
    "ocaml_sanity_check",
    "ocaml_windres",
    "ocaml_write",
)
load("//bazel:win_docker.bzl", "weidu_win_docker")

package(default_visibility = ["//visibility:public"])

# arch2.ml content (Depends' echo rule): platform strings baked in.
_ARCH2_TAIL = 'Var.set_string "WEIDU_VER" Version.version\nlet _ = associate_these ()\n'
_ARCH2_CONTENT_UNIX = 'let associate_these a = Var.set_string "WEIDU_ARCH" "amd64" ; Var.set_string "WEIDU_OS" "unix"; ' + _ARCH2_TAIL
_ARCH2_CONTENT_WIN = 'let associate_these a = Var.set_string "WEIDU_ARCH" "amd64" ; Var.set_string "WEIDU_OS" "win32"; ' + _ARCH2_TAIL
_ARCH2_CONTENT_OSX = 'let associate_these a = Var.set_string "WEIDU_ARCH" "amd64" ; Var.set_string "WEIDU_OS" "osx"; ' + _ARCH2_TAIL

# ---------------------------------------------------------------------------
