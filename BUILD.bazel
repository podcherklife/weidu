weidu_win_docker(
    name = "weidu_win_docker",
    build_script = "docker/win-cross/build_weidu.sh",
    dockerfile = "docker/win-cross/Dockerfile",
    srcs = [":docker_srcs"],
    tags = ["manual"],
)

# Platform dispatch: on Windows target platforms the exes come from the
# container cross-build (works on any host with docker or podman; a
# Windows exec host needs WSL2 docker or Docker Desktop), otherwise from
# the native toolchain build.
alias(
    name = "weidu",
    actual = select({
        "//platforms:windows": ":weidu_win_docker",
        "//conditions:default": ":weidu_native",
    }),
)
alias(
    name = "weinstall",
    actual = select({
        "//platforms:windows": ":weidu_win_docker",
        "//conditions:default": ":weinstall_native",
    }),
)
alias(
    name = "tolower",
    actual = select({
        "//platforms:windows": ":weidu_win_docker",
        "//conditions:default": ":tolower_native",
    }),
)

# Same assertions as //:sanity, against the PE exe produced by the docker
# cross-build, executed through wine (hosts with wine installed; the CI
# job installs wine64).  Manual: only built when requested explicitly.
ocaml_sanity_check(
    name = "sanity_win",
    bad_file = "not-token.d",
    binary = ":weidu_win_docker",
    good_file = "make-foozle.d",
    local = True,
    roundtrip_expect = "Abracadabra",
    runner = "wine",
    stage = {
        "test/bad-syntax/not-token.d": "not-token.d",
        "test/no-game/make-foozle.d": "make-foozle.d",
    },
    tags = ["manual"],
)
