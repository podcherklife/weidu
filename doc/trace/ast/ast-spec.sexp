(ast-spec
  (spec-version 1)
  (weidu-version "25201")
  ; bootstrap-extracted from the WeiDU sources by doc/trace/ast/tools/extract_spec.py; 55 defs.
  ; See spec-format.md for the format contract.  Consumers must
  ; ignore attributes they do not know (e.g. src).
  (scalars unit bool int int32 string)
  (encodings
    ; how each scalar renders on the wire (see spec-format.md)
    (scalar string quoted)            ; double-quoted, escaped
    (scalar int (atom decimal))       ; bare atom
    (scalar int32 (atom decimal))     ; bare atom
    (scalar bool (atom true false))   ; bare atoms
    (scalar unit empty)               ; renders as nothing
    ; absent option renders as the bare atom `none`; present as
    ; a (some <value>) node.  `none` is reserved: no scalar
    ; type can produce it, so absence is decidable from the
    ; declared type alone.
    (option (absent none) (present some))
  )

